<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ nickname }} · QQ 空间存档</title>
<style>
  :root {
    {{ theme_variables }}
    --accent-2: #397dab;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background:
      var(--bg);
    color: var(--text);
    font: 15px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    min-height: 100vh;
  }
  a { color: var(--accent); text-decoration: none; }
  header {
    position: sticky; top: 0; z-index: 20;
    backdrop-filter: blur(18px);
    background: rgba(242,248,252,.94);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: 1180px; margin: 0 auto; padding: 18px 24px;
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  }
  .brand { display: flex; flex-direction: column; gap: 2px; margin-right: auto; }
  .brand h1 { margin: 0; font-size: 18px; font-weight: 650; letter-spacing: .2px; }
  .brand span { color: var(--muted); font-size: 12px; }
  .stats { display: flex; gap: 16px; color: var(--muted); font-size: 12px; }
  .stats b { color: var(--text); font-weight: 600; }
  .search {
    background: var(--panel); border: 1px solid var(--line); color: var(--text);
    border-radius: 10px; padding: 9px 13px; width: 220px; outline: none;
    transition: border-color var(--motion), box-shadow var(--motion);
  }
  .search:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(122,162,247,.12); }
  .search::placeholder { color: #8b9ca8; }

  .tabs {
    max-width: 1180px; margin: 0 auto; padding: 0 24px 16px;
    display: flex; gap: 8px;
  }
  .tab {
    border: 1px solid var(--line); background: transparent; color: var(--muted);
    padding: 7px 16px; border-radius: 999px; cursor: pointer; font-size: 13px;
    transition: all var(--motion);
  }
  .tab:hover { color: var(--text); border-color: #3a434f; }
  .tab.active {
    color: #eef4f8; background: var(--accent); border-color: var(--accent); font-weight: 600;
  }

  main { max-width: 1180px; margin: 0 auto; padding: 8px 24px 80px; }
  section { display: none; }
  section.active { display: block; animation: fade var(--motion) ease; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .month {
    display: flex; align-items: baseline; gap: 12px;
    margin: 34px 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--line);
  }
  .month h2 { margin: 0; font-size: 15px; font-weight: 600; letter-spacing: .5px; }
  .month span { color: var(--muted); font-size: 12px; }

  .grid {
    display: grid; gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  .tile {
    position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 12px;
    background: var(--panel); border: 1px solid var(--line); cursor: zoom-in;
  }
  .tile img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform var(--motion) cubic-bezier(.2,.7,.2,1), opacity var(--motion);
  }
  .tile:hover img { transform: scale(1.045); }
  .tile .meta {
    position: absolute; inset: auto 0 0 0; padding: 22px 10px 8px;
    background: linear-gradient(transparent, rgba(0,0,0,.72));
    font-size: 11px; color: #cfd6df; opacity: 0; transition: opacity var(--motion);
  }
  .tile:hover .meta { opacity: 1; }
  .tile .missing {
    position: absolute; inset: 0; display: grid; place-items: center;
    color: #8b9ca8; font-size: 12px;
  }
  .badge {
    position: absolute; top: 8px; left: 8px; padding: 2px 7px; border-radius: 999px;
    background: rgba(242,248,252,.94); border: 1px solid rgba(255,255,255,.12);
    font-size: 10px; color: #cfd6df; letter-spacing: .3px;
  }
  .badge.video { color: var(--accent-2); }

  .album-grid {
    display: grid; gap: 16px; margin-top: 22px;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .album {
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; cursor: pointer; transition: transform var(--motion), border-color var(--motion);
  }
  .album:hover { transform: translateY(-3px); border-color: #37414d; }
  .album .cover { aspect-ratio: 4/3; background: var(--panel-2); overflow: hidden; }
  .album .cover img { width: 100%; height: 100%; object-fit: cover; }
  .album .body { padding: 12px 14px 14px; }
  .album .body h3 { margin: 0 0 2px; font-size: 14px; font-weight: 600; }
  .album .body p { margin: 0; color: var(--muted); font-size: 12px; }

  .mood {
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 18px 20px; margin-bottom: 14px;
  }
  .mood .head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .mood .time { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .mood .loc { color: var(--accent-2); font-size: 11px; }
  .mood .content { white-space: pre-wrap; word-break: break-word; }
  .mood .imgs {
    display: grid; gap: 6px; margin-top: 12px;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    max-width: 640px;
  }
  .mood .imgs img {
    width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; cursor: zoom-in;
  }
  .mood .foot { margin-top: 10px; color: var(--muted); font-size: 12px; display: flex; gap: 14px; }

  .empty { color: var(--muted); text-align: center; padding: 80px 0; }

  #lightbox {
    position: fixed; inset: 0; z-index: 50; display: none;
    background: rgba(5,6,8,.94); backdrop-filter: blur(8px);
    align-items: center; justify-content: center; padding: 4vw;
    cursor: zoom-out;
  }
  #lightbox.open { display: flex; }
  #lightbox img { max-width: 100%; max-height: 100%; border-radius: 8px; }
  #lightbox .caption {
    position: absolute; bottom: 18px; left: 0; right: 0; text-align: center;
    color: #9aa4b2; font-size: 12px;
  }
  footer {
    max-width: 1180px; margin: 0 auto; padding: 0 24px 40px;
    color: #8b9ca8; font-size: 12px;
  }
  @media (max-width: 640px) {
    .bar { padding: 14px 16px; }
    .search { width: 100%; }
    main { padding: 4px 16px 60px; }
    .tabs { padding: 0 16px 12px; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); }
  }
  header {background:var(--navy);color:white;border:0;backdrop-filter:none;}
  .brand h1 {color:white;font-size:22px;font-weight:700;}
  .brand span, header .stats, header .stats b {color:#c5d9ed;}
  .tab {background:var(--panel);color:var(--accent);}
  .tab:hover {border-color:var(--accent);background:var(--soft);}
  .tab.active {color:white;background:var(--accent);}
  .tab:focus-visible, .tile:focus-visible, .album:focus-visible {outline:3px solid #77c6ff;outline-offset:3px;}
  button, input, select {font:inherit;}
  header .search {font-size:13px;}
  .space-cover {margin:24px 0;background:linear-gradient(115deg,var(--navy),#397dab);color:white;
    padding:28px;border-radius:var(--radius);box-shadow:var(--shadow);}
  .space-cover h2 {margin:8px 0;font-size:var(--title);font-weight:700;}
  .space-cover p {margin:0;color:#d3e5f4;font-size:13px;}
  #timeline, #moods {max-width:850px;margin:0 auto;}
  .mood {box-shadow:var(--shadow);padding:22px 24px;transition:border-color var(--motion);}
  .mood:hover, .album:hover {border-color:#a9c9e3;}
  .mood .head {gap:12px;margin-bottom:18px;color:var(--navy);font-size:13px;}
  .mood .head::before {content:'Q';display:grid;place-items:center;flex-shrink:0;width:38px;height:38px;
    border-radius:50%;background:var(--soft);color:var(--accent);font-weight:700;}
  .mood .content {font-size:15px;line-height:1.85;}
  .mood .grid, .mood .imgs {display:grid;grid-template-columns:repeat(3,minmax(0,164px));gap:8px;margin-top:16px;max-width:508px;}
  .mood .foot {border-top:1px solid var(--line);padding-top:14px;margin-top:18px;color:var(--accent);}
  .album:hover {transform:translateY(-2px);}
  .badge {color:var(--text);}
  .result-count {color:var(--muted);font-size:12px;}
  .mood.album {height:auto;}
  .empty {background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);margin-top:24px;}
  @media (max-width:640px) {
    .stats {flex-wrap:wrap;}
    .tabs {flex-wrap:wrap;}
    .space-cover {padding:20px;}
    .mood {padding:18px 16px;}
    .mood .head {flex-wrap:wrap;}
  }
  @media (prefers-reduced-motion:reduce) {
    *, *::before {animation:none!important;transition:none!important;scroll-behavior:auto!important;}
  }
</style>
</head>
<body>
<header>
  <div class="bar">
    <div class="brand">
      <h1>扣扣时光</h1>
      <span>{% if uin %}QQ {{ uin }}{% else %}保留账号来源 · 可按账号筛选{% endif %} · 导出于 {{ generated_at }}</span>
    </div>
    <div class="stats">
      <span><b id="s-total">{{ stats.photos }}</b> 张照片</span>
      <span><b>{{ stats.videos }}</b> 个视频</span>
      <span><b>{{ stats.albums }}</b> 个相册</span>
      <span><b>{{ stats.moods }}</b> 条说说</span>
    </div>
    <input class="search" id="search" placeholder="搜索相册、文件名、说说…">
  </div>
  <nav class="tabs">
    <button class="tab active" data-view="timeline">时间轴</button>
    <button class="tab" data-view="albums">相册</button>
    <button class="tab" data-view="moods">说说</button>
    <button class="tab" data-view="photos">照片</button>
  </nav>
</header>

<main>
  <div class="space-cover">
    <p>QZONE / 我的离线空间</p>
    <h2>{{ nickname }} 的空间存档</h2>
    <p>说说 · 相册 · 照片，把每一年的回忆放回空间里。</p>
  </div>
  <section id="timeline" class="active"></section>
  <section id="albums"></section>
  <section id="moods"></section>
  <section id="photos"></section>
</main>

<footer>本页面由扣扣时光 · QZoneCapsule 生成，所有数据均来自本地备份，不发起任何网络请求。</footer>

<div id="lightbox"><img alt=""><div class="caption"></div></div>

<script src="data.js"></script>
<script>
(() => {
  const ALL_DATA = window.__QZONE_DATA__ || { photos: [], albums: [], moods: [] };
  let DATA = ALL_DATA;
  const $ = (s) => document.querySelector(s);
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => (
    { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]
  ));
  const emotionText = (s) => esc(s).replace(/\[em\]\s*e(\d+)\s*\[\/em\]/gi, (_, id) => {
    const face = ALL_DATA.emotions?.[id];
    return `<span title="Emoji替代：${esc(face?.name || '语义未确认，使用中性表情')}，原编号 e${id}">${esc(face?.emoji || '😶')}</span>`;
  });
  const plainEmotion = (s) => String(s ?? '').replace(/\[em\]\s*e(\d+)\s*\[\/em\]/gi,
    (_, id) => ALL_DATA.emotions?.[id]?.emoji || `😶（语义未确认，原编号 e${id}）`);

  function ownerLabel(uin) {
    const account = ALL_DATA.accounts?.find(a => a.uin === uin);
    return esc(account?.nickname || (uin === ALL_DATA.uin ? ALL_DATA.nickname : '') || `QQ ${uin || ''}`);
  }

  function moodCard(m) {
    const media = (m.media || []).filter(x => x.path);
    return `<article class="mood"><div class="head"><div><strong>${ownerLabel(m.uin || ALL_DATA.uin)}</strong>
      <div class="time">${esc(m.time || '未知时间')} · 发表了说说</div></div></div>
      <div class="content">${emotionText(m.content)}</div>
      <div class="grid">${media.map(x => mediaTile({...x, name:m.content, time:m.time})).join('')}</div>
      <div class="foot"><span>♡ ${Number(m.like_count)||0}</span><span>评论 ${Number(m.comment_count)||0}</span></div></article>`;
  }

  function mediaTile(item) {
    const label = plainEmotion([item.name || item.sloc || "", item.desc || "", item.text_note || "", item.uin ? `QQ ${item.uin}` : ""].filter(Boolean).join(" · "));
    const badge = item.is_video ? '<span class="badge video">VIDEO</span>' : "";
    if (!item.path) {
      return `<div class="tile">${badge}<div class="missing">未下载</div>
        <div class="meta">${esc(label)}</div></div>`;
    }
    return `<div class="tile" role="button" tabindex="0" data-src="${esc(item.path)}" data-cap="${esc(label)}">
      ${badge}
      <img loading="lazy" src="${esc(item.path)}" alt="${esc(label)}"
           onerror="this.style.opacity=0">
      <div class="meta">${esc(item.time || "")} ${item.uin ? esc(`QQ ${item.uin}`) : ""}</div>
    </div>`;
  }

  function renderTimeline(filter = "") {
    const records = [
      ...DATA.moods.map(x => ({x,kind:'mood',time:x.time||''})),
      ...DATA.photos.map(x => ({x,kind:'photo',time:x.time||''})),
      ...DATA.albums.map(x => ({x,kind:'album',time:x.last_upload_at||x.created_at||''}))
    ].filter(({x,time}) => !filter || `${x.name||''} ${x.desc||''} ${x.content||''} ${time}`.toLowerCase().includes(filter))
      .sort((a,b) => b.time.localeCompare(a.time));
    if (!records.length) { $('#timeline').innerHTML='<div class="empty">暂无匹配内容</div>'; return; }
    let month='';
    $('#timeline').innerHTML=`<p class="result-count">${records.length} 条内容 · 全部已显示</p>` + records.map(({x,kind,time}) => {
      const date=time.slice(0,7)||'未知时间';
      const heading=month!==date ? `<div class="month"><h2>${esc(date)}</h2></div>` : '';
      month=date;
      if (kind==='mood') return heading+moodCard(x);
      if (kind==='photo') return heading+`<article class="mood"><div class="head"><div><strong>${ownerLabel(x.uin||ALL_DATA.uin)}</strong><div class="time">${esc(time)} · 上传了照片</div></div></div><div class="content">${emotionText(x.name||'')}${x.desc?'<br>'+emotionText(x.desc):''}</div><div class="grid">${mediaTile(x)}</div></article>`;
      return heading+`<article class="mood album" data-album="${esc(x.id)}"><div class="body"><h3>${emotionText(x.name)}</h3><p>QQ ${esc(x.uin||ALL_DATA.uin||'')} · ${(x.photos||[]).length} 张/段 · 点击浏览相册</p></div></article>`;
    }).join('');
  }

  function renderAlbums(filter = "") {
    const albums = DATA.albums.filter((a) => {
      if (!filter) return true;
      return `${a.name} ${a.desc}`.toLowerCase().includes(filter);
    });
    if (!albums.length) {
      $("#albums").innerHTML = '<div class="empty">没有匹配的相册</div>';
      return;
    }
    $("#albums").innerHTML = `<div class="album-grid">${albums.map((a) => `
      <article class="album" role="button" tabindex="0" data-album="${esc(a.id)}">
        <div class="cover">${a.photos[0]?.path
          ? `<img loading="lazy" src="${esc(a.photos[0].path)}" alt="">` : ""}</div>
        <div class="body">
          <h3>${emotionText(a.name)}</h3>${a.uin ? `<p>QQ ${esc(a.uin)}</p>` : ""}
          <p>${a.photos.length} 张 · ${esc((a.last_upload_at || a.created_at || "").slice(0, 10))}</p>
        </div>
      </article>`).join("")}</div>`;
  }

  function renderMoods(filter = "") {
    const moods = DATA.moods.filter((m) => {
      if (!filter) return true;
      return `${m.content} ${m.location}`.toLowerCase().includes(filter);
    });
    if (!moods.length) {
      $("#moods").innerHTML = '<div class="empty">没有匹配的说说</div>';
      return;
    }
    $("#moods").innerHTML = moods.map((m) => {
      const imgs = (m.media || []).filter((x) => x.path)
        .map((x) => `<img loading="lazy" src="${esc(x.path)}" alt="" data-src="${esc(x.path)}">`)
        .join("");
      return `<article class="mood">
        <div class="head">
          <div><strong>${ownerLabel(m.uin || ALL_DATA.uin)}</strong><div class="time">${esc(m.time || "未知时间")}</div></div>
          ${m.location ? `<span class="loc">${esc(m.location)}</span>` : ""}
        </div>
        <div class="content">${emotionText(m.content)}</div>
        ${imgs ? `<div class="imgs">${imgs}</div>` : ""}
        <div class="foot">
          <span>赞 ${m.like_count}</span><span>评论 ${m.comment_count}</span>
        </div>
      </article>`;
    }).join("");
  }

  function show(view, filter = "") {
    document.querySelectorAll(".tab").forEach((t) => t.classList.toggle("active", t.dataset.view === view));
    document.querySelectorAll("section").forEach((s) => s.classList.toggle("active", s.id === view));
    if (view === "timeline") renderTimeline(filter);
    if (view === "albums") renderAlbums(filter);
    if (view === "moods") renderMoods(filter);
    if (view === "photos") $("#photos").innerHTML = `<div class="grid">${DATA.photos.filter(p => !filter || `${p.name||''} ${p.desc||''} ${p.time||''}`.toLowerCase().includes(filter)).map(mediaTile).join('')}</div>`;
  }

  document.querySelectorAll(".tab").forEach((tab) => {
    tab.addEventListener("click", () => show(tab.dataset.view, $("#search").value.trim().toLowerCase()));
  });

  let timer;
  if ((ALL_DATA.accounts || []).length) {
    const select = document.createElement("select");
    select.className = "search";
    select.setAttribute("aria-label", "选择所属账号");
    const all = new Option("合并查看全部账号", "");
    select.add(all);
    for (const account of ALL_DATA.accounts) {
      select.add(new Option(`${account.nickname || "QQ"} · ${account.uin}`, account.uin));
    }
    $("#search").before(select);
    select.addEventListener("change", () => {
      DATA = select.value ? {
        ...ALL_DATA,
        photos: ALL_DATA.photos.filter(x => x.uin === select.value),
        albums: ALL_DATA.albums.filter(x => x.uin === select.value),
        moods: ALL_DATA.moods.filter(x => x.uin === select.value)
      } : ALL_DATA;
      show(document.querySelector(".tab.active").dataset.view, $("#search").value.trim().toLowerCase());
    });
  }
  $("#search").addEventListener("input", (e) => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const active = document.querySelector(".tab.active").dataset.view;
      show(active, e.target.value.trim().toLowerCase());
    }, 160);
  });

  document.addEventListener("click", (e) => {
    const album = e.target.closest(".album");
    if (album) {
      const item = DATA.albums.find((a) => a.id === album.dataset.album);
      if (item) {
        show("albums");
        const photos = item.photos;
        $("#albums").innerHTML = `
          <div class="month"><h2>${emotionText(item.name)}</h2>
            <span>${photos.length} 张</span>
            <button class="tab" id="back-albums" style="margin-left:auto">返回相册</button>
          </div>
          <div class="grid">${photos.map(mediaTile).join("")}</div>`;
        $("#back-albums").addEventListener("click", () => renderAlbums());
      }
      return;
    }

    const tile = e.target.closest("[data-src]");
    if (tile) {
      const box = $("#lightbox");
      box.querySelector("img").src = tile.dataset.src;
      box.querySelector(".caption").textContent = tile.dataset.cap || "";
      box.classList.add("open");
    }
  });

  $("#lightbox").addEventListener("click", () => $("#lightbox").classList.remove("open"));
  document.addEventListener("keydown", (e) => {
    if ((e.key === "Enter" || e.key === " ") && e.target.matches('[role="button"]')) {
      e.preventDefault();
      e.target.click();
    }
    if (e.key === "Escape") $("#lightbox").classList.remove("open");
  });

  show("timeline");
})();
</script>
</body>
</html>
